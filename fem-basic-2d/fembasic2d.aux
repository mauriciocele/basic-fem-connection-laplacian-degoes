\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The discrete transport from vertex $i$ into face $f$. The smallest rotation $Q$, about the axis $n_i \times n_f$ (dashed), takes the vertex plane (blue) onto the face plane (orange); the frame vector $t_i$ becomes $Q t_i \setbox \z@ \hbox {\mathsurround \z@ $\textstyle Q$}\mathaccent "0365{Q}$ (green, written as a rotor as in Part\nonbreakingspace \ref {part:ga}), which makes the angle $\rho _i^f$ with the face frame vector $t_f$. The matrix $R_i^f$ is the rotation by $\rho _i^f$.}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:rotor_transport}{{5}{8}{The discrete transport from vertex $i$ into face $f$. The smallest rotation $Q$, about the axis $n_i \times n_f$ (dashed), takes the vertex plane (blue) onto the face plane (orange); the frame vector $t_i$ becomes $Q t_i \widetilde Q$ (green, written as a rotor as in Part~\ref {part:ga}), which makes the angle $\rho _i^f$ with the face frame vector $t_f$. The matrix $R_i^f$ is the rotation by $\rho _i^f$}{figure.caption.9}{}}
