\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces The tangent bivector $\mathsf  T = I n$ as an oriented disk in the tangent plane. Right multiplication by $\mathsf  T$ turns a tangent vector $a$ by a quarter turn in the sense of $\mathsf  T$, twice gives $-a$, and $e^{\mathsf  T \theta } = \cos \theta + \mathsf  T \sin \theta $ turns it by $\theta $: the even elements of the plane are the complex numbers, with $\mathsf  T$ as imaginary unit.}}{30}{figure.caption.32}\protected@file@percent }
\newlabel{fig:quarter_turn}{{17}{30}{The tangent bivector $\mathsf T = I n$ as an oriented disk in the tangent plane. Right multiplication by $\mathsf T$ turns a tangent vector $a$ by a quarter turn in the sense of $\mathsf T$, twice gives $-a$, and $e^{\mathsf T \theta } = \cos \theta + \mathsf T \sin \theta $ turns it by $\theta $: the even elements of the plane are the complex numbers, with $\mathsf T$ as imaginary unit}{figure.caption.32}{}}
